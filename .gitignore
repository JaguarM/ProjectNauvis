# Other people's work, supplied as reference. Never committed — not ours to redistribute.
# Ignore the whole directory rather than naming subfolders: a new reference drop must not
# become a commit just because nobody remembered to add a line here.
reference/*
!reference/README.md

# Dev server working directory
run/

# Gradle
.gradle/
build/
*/build/

# IDE output. VS Code's Java tooling compiles into bin/ beside Gradle's build/, and a copy of
# every resource in there is not a source of anything.
bin/
*/bin/

# Python bytecode from tools/
__pycache__/
*.pyc

# Preview sheets the texture scripts write with --preview
texture-workshop/*-preview.png
