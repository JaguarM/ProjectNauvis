# Other people's work, supplied as reference. Never committed — not ours to redistribute.
# Ignore the whole directory rather than naming subfolders: a new reference drop must not
# become a commit just because nobody remembered to add a line here.
reference/*
!reference/README.md

# Dev server working directory
run/

# Gradle
.gradle/
build/
*/build/

# Python bytecode from tools/
__pycache__/
*.pyc
